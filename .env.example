# AUU Market Terminal — paper/mock only. venue=Pump.fun. Do NOT put real API keys or wallets here.
DATA_PROVIDER=mock
# pumpfun_paper = synthetic curve (excluded from Go). pumpfun_live_paper = real prints/reserves, paper fills only.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# Frontend (apps/web/.env) — leave empty to use Vite proxy / same-origin nginx
VITE_API_BASE=

# Pump.fun paper market (local curve simulator — no wallet, no sendTransaction)
# DATA_PROVIDER=pumpfun_paper
# DATA_PROVIDER=pumpfun_live_paper   # real on-chain prints; see docs/adapters/pumpfun-live-paper-v0.md
# LIVE_PAPER_FEED=auto        # auto|portal|logs|off — read-only trade feed, never sends a transaction.
#                             # auto prefers free logsSubscribe; PumpPortal subscribeTokenTrade is metered per message
# LIVE_PAPER_RPC_URL=         # read-only getAccountInfo for bonding-curve checks (default SOLANA_RPC_URL)
# PAPER_FILL_LATENCY_MS=300   # decision→fill latency; fill on the first real print after it
# LIVE_PAPER_ENTRY_TTL_MS=30000
# PAPER_CURVE_PROTOCOL_FEE_BPS=   # raise-only floor when no TradeEvent fee was observed (default 95)
# PAPER_CURVE_CREATOR_FEE_BPS=    # raise-only floor when no TradeEvent creator fee was observed (default 30)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# PUMPFUN_WATCH_MINTS=   # comma list: mint or mint:TICKER or mint:TICKER:progress_bps ; empty = built-in demos
# AUTO_PAPER_ORDERS=false   # pump-paper-v1 / strategy_autopaper; never auto-submits unless true
# PUMP_PAPER_LOOP=1         # background evaluate → WS signal ; 0 to disable
# PUMPFUN_DISCOVERY=        # pumpportal | logs | off  (default: pumpportal if PUMPFUN_PORTAL_API_KEY set, else off)
# PUMPFUN_PORTAL_API_KEY=   # env only; ONE token. Quoted value with two space-separated keys → HTTP 400; never commit. subscribeNewToken is read-only (no trades)
# PUMPFUN_DISCOVERY_FALLBACK=  # default: on Portal 400/403, fall back to logs when SOLANA_RPC_URL is set; set off to disable
# Trader watch (observe → habit → distill). Addresses only; no private keys; no copy-trade.
# TRADER_WATCH_WALLETS=     # optional extra comma-separated addresses (dev seed)
# TRADER_WATCH_READER=mock  # mock | helius | rpc  (default mock; live HTTP off)
# TRADER_WATCH_LIVE_FETCH=  # 1 only with HELIUS_API_KEY or SOLANA_RPC_URL; still no sendTransaction
# HELIUS_API_KEY=           # env only; never commit; unused unless reader=helius and LIVE_FETCH=1
# SOLANA_TRACKER_API_KEY=   # later enrich; unused unless TRADER_WATCH_ENRICH=tracker
# BITQUERY_API_KEY=         # later enrich; unused unless TRADER_WATCH_ENRICH=bitquery
# TRADER_WATCH_ENRICH=off   # off | tracker | bitquery
# TRADER_WATCH_STORE=       # optional JSON path for watchlist
# TRADER_DISTILL_OVERLAY=   # optional JSON path for confirmed paper param overlay
# Forbidden: PRIVATE_KEY / WALLET_SECRET / trading API keys / Jito tips

# Live adapter (DISABLED by default). This tree does not send chain txs.
# LiveLimits are locked and separate from paper: 1.0 SOL / order, 4.5% day loss, 10 open mints.
# AUU_LIVE_ENABLED=false
# AUU_LIVE_DISABLED=true
# AUU_LIVE_ARMED=false
# LOCAL-ONLY keypair (gitignored). JSON array of 64 ints. Do not paste a secret here.
# AUU_SOLANA_KEYPAIR_PATH=secrets/live-keypair.json

# Paper accounts. Default off so a local PC trades without logging in.
# Docker Compose sets AUU_AUTH=on. No deposits, withdrawals, or live orders.
# AUU_AUTH=off
# AUU_ALLOW_SIGNUP=on          # false closes public signup
# AUU_INVITE_CODE=             # unset = open signup; set to require a code
# AUU_ADMIN_USER=
# AUU_PAPER_START_SOL=100
# AUU_SESSION_SECRET=auu-paper-dev
# AUU_AUTH_RATE_MAX=20         # login/signup attempts per window
# AUU_AUTH_RATE_WINDOW=600
# AUU_USER_STORE=
# AUU_USER_JOURNAL_DIR=
# Email verification codes at signup + 忘记密码 (off by default). QQ: smtp.qq.com:465, 163: smtp.163.com:465.
# AUU_SMTP_PASS is the mailbox SMTP authorization code (授权码), not the login password. Never commit it.
# AUU_EMAIL_VERIFY=off
# AUU_SMTP_HOST=smtp.qq.com
# AUU_SMTP_PORT=465            # 465 = SSL; any other port uses STARTTLS
# AUU_SMTP_STARTTLS=           # optional on/off override of the port rule
# Gmail: AUU_SMTP_HOST=smtp.gmail.com, port 465 or 587, AUU_SMTP_PASS = 16-char Google App Password (spaces and invisible characters such as U+200B/U+FEFF/U+00A0 are stripped)
# AUU_SMTP_USER=               # sender address, e.g. yourname@qq.com
# AUU_SMTP_PASS=
# AUU_EMAIL_IP_MAX=10          # code sends per IP per window
# AUU_EMAIL_IP_WINDOW=3600

# Non-custodial wallet. Default off. The server stores pubkeys only and never signs.
# AUU_WALLET_MODE=off          # off | devnet | mainnet (mainnet orders need the user to sign)
# SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
# SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
# PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local
# AUU_WALLET_STORE=
# AUU_WALLET_CHALLENGE_TTL=300
# AUU_WALLET_PREPARE_TTL=90
# AUU_WALLET_PRIORITY_FEE=0.00001
# Public browser RPC only. Do not put an API key in the frontend bundle.
# VITE_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
