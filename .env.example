# AUU Market Terminal — paper/mock only. venue=Pump.fun. Do NOT put real API keys or wallets here.
DATA_PROVIDER=mock
# pumpfun_paper also accepted (local bonding-curve sim; still no live keys)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# Frontend (apps/web/.env) — leave empty to use Vite proxy / same-origin nginx
VITE_API_BASE=

# Pump.fun paper market (local curve simulator — no wallet, no sendTransaction)
# DATA_PROVIDER=pumpfun_paper
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# PUMPFUN_WATCH_MINTS=   # comma list: mint or mint:TICKER or mint:TICKER:progress_bps ; empty = built-in demos
# AUTO_PAPER_ORDERS=false   # pump-paper-v1 / strategy_autopaper; never auto-submits unless true
# PUMP_PAPER_LOOP=1         # background evaluate → WS signal ; 0 to disable
# PUMPFUN_DISCOVERY=        # pumpportal | logs | off  (default: pumpportal if PUMPFUN_PORTAL_API_KEY set, else off)
# PUMPFUN_PORTAL_API_KEY=   # env only; never commit. subscribeNewToken is read-only (no trades)
# Trader watch (observe → habit → distill). Addresses only; no private keys; no copy-trade.
# TRADER_WATCH_WALLETS=     # optional extra comma-separated addresses (dev seed)
# TRADER_WATCH_READER=mock  # mock | helius  (helius stub default off; no HTTP in P0)
# HELIUS_API_KEY=           # env only; never commit; unused unless TRADER_WATCH_READER=helius
# TRADER_WATCH_STORE=       # optional JSON path for watchlist
# TRADER_DISTILL_OVERLAY=   # optional JSON path for confirmed paper param overlay
# Forbidden: PRIVATE_KEY / WALLET_SECRET / trading API keys / Jito tips
